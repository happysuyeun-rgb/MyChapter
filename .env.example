# Copy to .env.local (untracked). Restart `npm run dev` after edits.
# Never put service-role keys, private tokens, or passwords in VITE_* variables.
# Vite embeds VITE_* at build time. Redeploy after changing production env.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key
VITE_PRIVACY_POLICY_URL=https://mychapter.app/legal/privacy.html
VITE_TERMS_URL=https://mychapter.app/legal/terms.html
VITE_BILLING_DEV_MODE=false
VITE_APP_URL=http://localhost:5173
VITE_DEV_BYPASS=false
